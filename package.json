{
  "name": "sirocco-schoolops",
  "private": true,
  "version": "0.1.0-rc.2",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "security:audit": "node scripts/audit-dependencies.mjs",
    "dev": "pnpm --filter @sirocco/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/test/*.test.mjs",
    "test:e2e": "playwright test",
    "demo:init": "node scripts/init.mjs",
    "demo:up": "node scripts/up.mjs",
    "demo:down": "docker compose down",
    "demo:logs": "docker compose logs --tail 100",
    "demo:verify": "node scripts/verify.mjs",
    "demo:verify:g01": "node scripts/verify-g01.mjs",
    "demo:verify:boundaries": "node scripts/verify-boundaries.mjs",
    "demo:verify:headless": "node scripts/verify-headless-client.mjs",
    "docker:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repair-docker-runtime.ps1",
    "demo:verify:phase3": "node scripts/verify-phase3.mjs",
    "packs:validate": "node scripts/packs.mjs validate",
    "packs:install": "node scripts/packs.mjs install",
    "packs:activate": "node scripts/packs.mjs activate",
    "packs:list": "node scripts/packs.mjs list",
    "demo:verify:phase4": "node scripts/verify-phase4.mjs",
    "demo:users": "node scripts/sync-demo-users.mjs",
    "demo:replay:g02": "node scripts/replay-g02.mjs",
    "demo:verify:phase5": "node scripts/verify-phase5.mjs",
    "demo:verify:phase6": "node scripts/verify-phase6.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:restore": "node scripts/backup.mjs restore",
    "demo:verify:phase7": "node scripts/verify-phase7.mjs",
    "source:verify": "node scripts/verify-source.mjs",
    "release:prepare": "node scripts/release.mjs",
    "legal:audit": "node scripts/license-audit.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "type": "module",
  "license": "Apache-2.0"
}
