{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g02-case@1.0.0",
  "title": "Hồ sơ xử lý cảnh báo môi trường",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "roomId",
    "description"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "assetId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4000
    }
  }
}
