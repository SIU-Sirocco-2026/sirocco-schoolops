  "rule": {
    "version": "pm25-demo@1.0.0",
    "label": "Ngưỡng minh họa, không phải khuyến cáo sức khỏe",
    "threshold": 35,
    "openConsecutive": 2,
    "recoveryConsecutive": 2,
    "cooldownSeconds": 300,
    "gapSeconds": 300
  }
}
