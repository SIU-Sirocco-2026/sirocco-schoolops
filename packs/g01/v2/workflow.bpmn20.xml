<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://sirocco.schoolops/g01/v1">
  <process id="g01-facilities-v2" name="G01 — Xử lý sự cố cơ sở vật chất v1" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="startVerify" sourceRef="start" targetRef="verify"/>
    <userTask id="verify" name="Xác minh sự cố" flowable:assignee="${coordinator}"/>
    <sequenceFlow id="verifyDecision" sourceRef="verify" targetRef="verificationDecision"/>
    <exclusiveGateway id="verificationDecision" default="needsInfo"/>
    <sequenceFlow id="verified" sourceRef="verificationDecision" targetRef="assign"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${verified == true}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="needsInfo" sourceRef="verificationDecision" targetRef="supplement"/>
    <userTask id="supplement" name="Bổ sung thông tin" flowable:assignee="${reporter}"/>
    <sequenceFlow id="resubmit" sourceRef="supplement" targetRef="verify"/>
    <userTask id="assign" name="Giao việc" flowable:assignee="${coordinator}"/>
    <sequenceFlow id="assigned" sourceRef="assign" targetRef="receive"/>
    <userTask id="receive" name="Nhận việc" flowable:assignee="${technician}" flowable:candidateGroups="${team}" flowable:dueDate="${dueAt}"/>
    <sequenceFlow id="received" sourceRef="receive" targetRef="repair"/>
    <userTask id="repair" name="Xử lý sự cố" flowable:assignee="${technician}" flowable:dueDate="${dueAt}"/>
    <sequenceFlow id="submitted" sourceRef="repair" targetRef="approve"/>
    <userTask id="approve" name="Nghiệm thu" flowable:assignee="${approver}"/>
    <sequenceFlow id="approvalDecision" sourceRef="approve" targetRef="acceptanceDecision"/>
    <exclusiveGateway id="acceptanceDecision" default="rework"/>
    <sequenceFlow id="approved" sourceRef="acceptanceDecision" targetRef="end"><conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true}]]></conditionExpression></sequenceFlow>
    <sequenceFlow id="rework" sourceRef="acceptanceDecision" targetRef="repair"/>
    <endEvent id="end"/>
  </process>
</definitions>
